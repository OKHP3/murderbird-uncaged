*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text

# Runtime and art media: one flat folder, images stored in Git LFS.
media/*.png filter=lfs diff=lfs merge=lfs -text
media/*.webp filter=lfs diff=lfs merge=lfs -text
media/*.jpg filter=lfs diff=lfs merge=lfs -text
media/*.avif filter=lfs diff=lfs merge=lfs -text
media/** -text

# Records keep their original bytes, including historical CRLF.
records/*.png filter=lfs diff=lfs merge=lfs -text
records/** -text
favicon.ico -text

# Runtime text is copied verbatim into dist and compared with pinned hashes.
# Keep its checkout bytes identical on Windows, macOS and CI.
public/**/*.txt text eol=lf
public/**/*.svg text eol=lf
public/**/*.xml text eol=lf
public/**/*.html text eol=lf
public/**/*.webmanifest text eol=lf
index.html text eol=lf
folio.html text eol=lf
cg.html text eol=lf
